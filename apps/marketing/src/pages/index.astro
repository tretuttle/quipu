---
import Layout from "../layouts/Layout.astro";
import { DOWNLOAD_PAGE_PATH, SITE } from "../lib/site";

const { release, webAppPath } = SITE;

const features = [
  {
    id: "views",
    name: "Map, tree, table, and source",
    text: "Switch views without losing your selection. HAR files group by host, page, and request on the map and open in a sortable request table with an SVG timing waterfall and timeline scrubber.",
  },
  {
    id: "decode",
    name: "Decode and trace",
    text: "Decode nested stringified JSON, base64, gzip, JWTs (marked unverified), GraphQL, forms, NDJSON, SVG and raster images, and WebSocket frames. Turn on Deep decode to search inside encoded payloads and trace exact values across requests.",
  },
  {
    id: "query",
    name: "Search, JSONPath, and jq",
    text: "Parallel literal and regex search with worker timeouts, JSONPath filter predicates, and match-only filtering across views. jq runs directly up to 64 MiB or streams per element across larger arrays and HAR captures.",
  },
  {
    id: "edit",
    name: "Edit and convert",
    text: "Edit JSON and HAR values, rename keys, sort, format, and minify through a zero-copy PieceTable with unlimited undo and crash-recovery journals. Export to JSON, YAML, TOML, XML, CSV, TSV, or NDJSON.",
  },
  {
    id: "diff-schema",
    name: "Diff, schema, and codegen",
    text: "Diff two JSON files structurally or match HAR captures by method, URL, and resource type with inline body diffs. Infer shapes across all records, validate against local JSON Schema, and generate types for nine targets.",
  },
  {
    id: "annotate",
    name: "Annotate and export",
    text: "Attach notes, shapes, freehand ink, and bound arrows to map nodes or blank boards, and export the visible or full map to PNG or SVG. Ships with light, dark, and 7:1 contrast palettes plus VS Code theme import.",
  },
] as const;

const formats = ["JSON", "JSONC", "HAR", "NDJSON", "YAML", "TOML", "XML", "CSV", "TSV", "Plain text"];

const numbers = [
  { value: "366 ms", label: "First paint on a 1.86 GiB HAR (1.60 s full index, 1.50 GiB pre-deep RSS, median of 3)" },
  { value: "1.46 s", label: "Parallel search across 40,398 requests (7.95 s with deep base64 decode, median of 3)" },
  { value: "5.57 s", label: "HAR capture diff against a 1-edit copy including opening File B (40,397 same, 1 changed, median of 3)" },
  { value: "37 ms", label: "Live scalar edit on a 1.86 GiB HAR via PieceTable (single measured run)" },
] as const;

const limits = [
  {
    name: "Network isolation",
    text: "JSON and HAR files stay on disk and are read in 8 MiB slices. Content Security Policy restricts outbound hosts to Open VSX when browsing themes, and web end-to-end tests fail on any unexpected network request.",
  },
  {
    name: "Format and size limits",
    text: "Tested to a 2.00 GB (1.86 GiB) HAR and 100 MiB JSON, with a hard 4 GiB minus 1 byte address limit for JSON and HAR editing. YAML and TOML parse whole up to 256 MiB and open read-only alongside JSONC, NDJSON, XML, CSV, and TSV.",
  },
  {
    name: "Runtime requirements",
    text: "The browser build needs cross-origin isolation (COOP and COEP headers) for SharedArrayBuffer workers. Rendering uses Canvas2D, SVG, and DOM, with no WebGPU required.",
  },
] as const;
---

<Layout>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow" data-rise>Browser and desktop · MIT</p>
      <h1 class="hero-title display" data-rise style="--d:90ms">
        <span>Inspect and edit 2 GB HAR</span>
        <span class="hero-line">and large JSON files locally.</span>
      </h1>
      <p class="hero-sub" data-rise style="--d:180ms">
        Quipu streams JSON and HAR files from disk in 8&nbsp;MiB slices across parallel workers and
        also opens JSONC, NDJSON, YAML, TOML, XML, CSV, and TSV. Search raw or encoded payloads, run
        jq per element, diff captures, infer schemas, generate types, and edit JSON and HAR files up
        to the 4&nbsp;GiB address limit.
      </p>
      {
        (release !== null || webAppPath !== null) && (
          <div class="hero-actions" data-rise style="--d:270ms">
            {release !== null && (
              <a class="btn btn-primary btn-lg" href={release.linuxAppImage} download data-download="linux">
                Download for Linux
              </a>
            )}
            {release !== null && (
              <a class="btn btn-primary btn-lg" href={release.windowsInstaller} download data-download="windows">
                Download for Windows
              </a>
            )}
            {webAppPath !== null && (
              <a class:list={["btn btn-lg", release === null ? "btn-primary" : "btn-ghost"]} href={webAppPath}>
                Open in the browser
              </a>
            )}
          </div>
        )
      }
      <p class="hero-note" data-rise style="--d:330ms">
        {
          release !== null ? (
            <>
              Version {release.version}, unsigned. <a href={DOWNLOAD_PAGE_PATH}>How to run it</a>.
            </>
          ) : (
            "Desktop downloads for Linux and Windows will appear here with the first release."
          )
        }
      </p>

      <div class="hero-map-wrap" data-rise style="--d:420ms">
        <figure class="hero-map tile">
          <svg
            viewBox="0 0 780 360"
            role="img"
            aria-label="A HAR capture grouped by host, page, and request on the Quipu map, showing a POST entry linked to its decoded base64 JSON payload and PNG response body."
          >
            <g class="edges">
              <path d="M188 180 C 234 180, 234 94, 280 94" />
              <path d="M188 180 C 234 180, 234 264, 280 264" />
              <path d="M492 78 C 528 78, 528 68, 560 68" />
              <path d="M492 112 C 528 112, 528 158, 560 158" />
              <path d="M492 264 C 528 264, 528 264, 560 264" />
            </g>
            <g class="node">
              <rect x="16" y="136" width="172" height="88" rx="10" />
              <text x="32" y="164" class="k">api.example.com</text>
              <text x="32" y="188" class="n">page</text>
              <text x="98" y="188" class="s">"page_1"</text>
              <text x="32" y="208" class="n">entries</text>
              <text x="98" y="208" class="b">[ 40,398 ]</text>
            </g>
            <g class="node">
              <rect x="280" y="46" width="212" height="96" rx="10" />
              <text x="296" y="74" class="k">POST /v1/checkout</text>
              <text x="296" y="98" class="n">status</text>
              <text x="372" y="98" class="v">200</text>
              <text x="296" y="118" class="n">postData</text>
              <text x="372" y="118" class="b">base64, json</text>
            </g>
            <g class="node">
              <rect x="280" y="220" width="212" height="88" rx="10" />
              <text x="296" y="248" class="k">GET /assets/logo</text>
              <text x="296" y="272" class="n">status</text>
              <text x="372" y="272" class="v">200</text>
              <text x="296" y="292" class="n">content</text>
              <text x="372" y="292" class="b">{"{…}"}</text>
            </g>
            <g class="node node-decoded">
              <rect x="560" y="24" width="204" height="88" rx="10" />
              <text x="576" y="50" class="k">decoded (base64, json)</text>
              <text x="576" y="74" class="n">userId</text>
              <text x="640" y="74" class="s">"usr_8c41f0"</text>
              <text x="576" y="94" class="n">total</text>
              <text x="640" y="94" class="v">4200</text>
            </g>
            <g class="node">
              <rect x="560" y="128" width="204" height="60" rx="10" />
              <text x="576" y="154" class="k">headers</text>
              <text x="576" y="174" class="b">[ 18 ]</text>
            </g>
            <g class="node">
              <rect x="560" y="234" width="204" height="60" rx="10" />
              <text x="576" y="260" class="k">response.content</text>
              <text x="576" y="280" class="s">image/png · 18.4 KiB</text>
            </g>
          </svg>
        </figure>
      </div>
    </div>
  </section>

  <section class="formats" aria-label="Supported formats">
    <div class="container formats-inner">
      {formats.map((format) => <span class="format">{format}</span>)}
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="numbers-title">
    <div class="container">
      <div class="section-head">
        <h2 id="numbers-title" class="display">Measured on a 2 GB (1.86 GiB) HAR</h2>
        <p>
          Cold runs on an Intel Core i9-14900, 62&nbsp;GiB RAM, Chromium 148, against the production
          web build (60.0&nbsp;fps pan across all runs).
        </p>
      </div>
      <div class="numbers-grid">
        {
          numbers.map((item) => (
            <article class="number-card tile">
              <p class="number-value display">{item.value}</p>
              <p class="number-label">{item.label}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="features" class="section" aria-labelledby="features-title">
    <div class="container">
      <div class="section-head">
        <h2 id="features-title" class="display">Parallel scanning on a segmented tape</h2>
        <p>
          Up to 16 worker threads scan JSON and HAR files into a segmented structural tape so
          indexing, searching, editing, and diffing work on multi-gigabyte captures.
        </p>
      </div>
      <div class="feature-grid">
        {
          features.map((feature) => (
            <article class="feature tile" id={feature.id}>
              <h3>{feature.name}</h3>
              <p>{feature.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="limits" class="section section-alt" aria-labelledby="limits-title">
    <div class="container">
      <div class="section-head">
        <h2 id="limits-title" class="display">Local by default, with explicit limits</h2>
        <p>
          No backend, no accounts, and no telemetry. Here is where the engine stops and what the
          browser build requires.
        </p>
      </div>
      <div class="privacy-grid">
        {
          limits.map((item) => (
            <article class="privacy-item">
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="name-title">
    <div class="container name-note">
      <h2 id="name-title" class="display">The name</h2>
      <p>
        A quipu is the Inca record made of knotted cords, where strings hang from strings and knots
        hold values. It fits nested stringified JSON.
      </p>
    </div>
  </section>

  {
    (release !== null || webAppPath !== null) && (
      <section id="download" class="section section-cta" aria-labelledby="download-title">
        <div class="container cta-inner">
          <h2 id="download-title" class="display">Get Quipu</h2>
          <p>
            {release !== null && webAppPath !== null
              ? "Download the desktop app for Linux or Windows, or open Quipu in your browser."
              : release !== null
                ? "Download the desktop app for Linux or Windows."
                : "Open Quipu in your browser."}
          </p>
          <div class="hero-actions">
            {release !== null && (
              <a class="btn btn-primary btn-lg" href={DOWNLOAD_PAGE_PATH}>
                Download
              </a>
            )}
            {webAppPath !== null && (
              <a class:list={["btn btn-lg", release === null ? "btn-primary" : "btn-ghost"]} href={webAppPath}>
                Open in the browser
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .hero {
    padding: 9vh 0 3rem;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-title {
    margin-top: 18px;
    font-size: clamp(2.3rem, 5.6vw, 4.4rem);
  }

  .hero-line {
    display: block;
  }

  .hero-sub {
    margin-top: 24px;
    max-width: 46rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--muted-foreground);
  }

  .hero-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .hero-note {
    margin-top: 14px;
    font-size: 13px;
    color: var(--muted-foreground);
  }

  .hero-note a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-map-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-map {
    margin-top: 56px;
    width: min(880px, 100%);
    padding: 20px;
  }

  .hero-map svg {
    width: 100%;
    height: auto;
  }

  .edges path {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .node rect {
    fill: var(--muted);
    stroke: var(--border-strong);
  }

  .node-decoded rect {
    stroke: var(--primary);
  }

  .node text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--muted-foreground);
  }

  .node .k {
    fill: var(--foreground);
    font-weight: 600;
  }

  .node .s {
    fill: var(--success);
  }

  .node .v,
  .node .b {
    fill: var(--primary);
  }

  .formats {
    border-block: 1px solid var(--border);
    padding: 18px 0;
  }

  .formats-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
  }

  .format {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  .section {
    padding: 96px 0;
  }

  .section-alt {
    background: var(--muted);
    border-block: 1px solid var(--border);
  }

  .section-head {
    max-width: 44rem;
    margin-bottom: 48px;
  }

  .section-head h2,
  .name-note h2,
  .cta-inner h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
  }

  .section-head p,
  .name-note p,
  .cta-inner p {
    margin-top: 14px;
    color: var(--muted-foreground);
    font-size: 1.05rem;
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .number-card {
    padding: 24px;
  }

  .number-value {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    color: var(--foreground);
  }

  .number-label {
    margin-top: 10px;
    font-size: 0.9rem;
    color: var(--muted-foreground);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .feature {
    padding: 24px;
  }

  .feature h3,
  .privacy-item h3 {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .feature p,
  .privacy-item p {
    margin-top: 10px;
    color: var(--muted-foreground);
    font-size: 0.95rem;
  }

  .privacy-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  .name-note {
    max-width: 48rem;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (max-width: 960px) {
    .numbers-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature-grid,
    .privacy-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .container {
      padding-left: 20px;
      padding-right: 20px;
    }

    .section {
      padding: 64px 0;
    }

    .numbers-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
