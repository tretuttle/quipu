---
import Layout from "../layouts/Layout.astro";
import { DOWNLOAD_PAGE_PATH, SITE } from "../lib/site";

const { release, webAppPath } = SITE;

const features = [
  {
    id: "map",
    name: "Map",
    text: "The document is a node-link map on an infinite canvas. Collapse and expand any node, find your way with the minimap, and switch to the tree or source view without losing the selection.",
  },
  {
    id: "decode",
    name: "Decode",
    text: "Nested JSON strings open in place and are escaped again when you save. Base64 images preview, JWTs decode (the signature is never verified), and URL-encoded forms, GraphQL queries, NDJSON and WebSocket frames open as structure, one value at a time or automatically.",
  },
  {
    id: "search",
    name: "Search",
    text: "Literal and regular-expression search, with hits lit in every view. Path queries jump straight to a node, and a jq bar runs over the whole document or the selection.",
  },
  {
    id: "edit",
    name: "Edit",
    text: "Edit values and keys in JSON and HAR files, sort, format and minify, with undo and redo. Unsaved edits come back after a crash or reload. Save to the file, or export to JSON, YAML, TOML, XML or CSV.",
  },
  {
    id: "draw",
    name: "Draw",
    text: "Shapes, arrows, freehand, text, sticky notes and frames, on a blank board or over the map. On the map, arrows and notes attach to data nodes and follow them when the layout changes.",
  },
  {
    id: "themes",
    name: "Themes",
    text: "Built-in palettes, a theme editor, and VS Code color themes from Open VSX or a file. The map, the source view and the drawing ink recolor together.",
  },
] as const;

const formats = ["JSON", "JSONC", "HAR", "NDJSON", "YAML", "TOML", "XML", "CSV", "TSV", "Any file as text"];

const privacy = [
  {
    name: "Local-first",
    text: "Files are read where they live. Settings, recent files and drawings are kept in your browser or your app-data folder, never on a server.",
  },
  {
    name: "No accounts",
    text: "There is nothing to sign up for and nothing to sign in to. Quipu has no server and no AI features.",
  },
  {
    name: "No telemetry",
    text: "No analytics, no tracking, no crash reporting. The only network requests Quipu makes are to Open VSX, and only while you browse themes.",
  },
] as const;
---

<Layout>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow" data-rise>A local-first data canvas</p>
      <h1 class="hero-title display" data-rise style="--d:90ms">
        <span>Open any data file.</span> <span class="hero-line">See it as a map.</span>
      </h1>
      <p class="hero-sub" data-rise style="--d:180ms">
        Quipu turns JSON, HAR, NDJSON, YAML, TOML, XML and CSV files into a map you can search,
        decode, edit and draw on, with JSON and HAR files of up to 2&nbsp;GB. It runs in a browser tab
        and as a desktop app. Your files never leave your machine.
      </p>
      {
        (release !== null || webAppPath !== null) && (
          <div class="hero-actions" data-rise style="--d:270ms">
            {release !== null && (
              <a class="btn btn-primary btn-lg" href={release.linuxAppImage} download data-download="linux">
                Download for Linux
              </a>
            )}
            {release !== null && (
              <a class="btn btn-primary btn-lg" href={release.windowsInstaller} download data-download="windows">
                Download for Windows
              </a>
            )}
            {webAppPath !== null && (
              <a class:list={["btn btn-lg", release === null ? "btn-primary" : "btn-ghost"]} href={webAppPath}>
                Open in the browser
              </a>
            )}
          </div>
        )
      }
      <p class="hero-note" data-rise style="--d:330ms">
        {
          release !== null ? (
            <>
              Version {release.version}, unsigned. <a href={DOWNLOAD_PAGE_PATH}>How to run it</a>.
            </>
          ) : (
            "Desktop downloads for Linux and Windows will appear here with the first release."
          )
        }
      </p>

      <div class="hero-map-wrap" data-rise style="--d:420ms">
        <figure class="hero-map tile">
          <svg
            viewBox="0 0 760 360"
            role="img"
            aria-label="A HAR capture drawn as a map: the log object linked to a request and a response, each holding keys and values, with the request body decoded."
          >
            <g class="edges">
              <path d="M178 180 C 240 180, 240 84, 300 84" />
              <path d="M178 180 C 240 180, 240 270, 300 270" />
              <path d="M468 70 C 520 70, 520 56, 560 56" />
              <path d="M468 98 C 520 98, 520 128, 560 128" />
              <path d="M468 256 C 520 256, 520 252, 560 252" />
            </g>
            <g class="node">
              <rect x="24" y="140" width="154" height="80" rx="10" />
              <text x="40" y="168" class="k">log</text>
              <text x="40" y="192" class="n">version</text>
              <text x="108" y="192" class="s">"1.2"</text>
              <text x="40" y="210" class="n">entries</text>
              <text x="108" y="210" class="b">[ 4,218 ]</text>
            </g>
            <g class="node">
              <rect x="300" y="44" width="168" height="80" rx="10" />
              <text x="316" y="72" class="k">request</text>
              <text x="316" y="96" class="n">method</text>
              <text x="378" y="96" class="s">"POST"</text>
              <text x="316" y="114" class="n">postData</text>
              <text x="388" y="114" class="b">{"{…}"}</text>
            </g>
            <g class="node">
              <rect x="300" y="230" width="168" height="80" rx="10" />
              <text x="316" y="258" class="k">response</text>
              <text x="316" y="282" class="n">status</text>
              <text x="372" y="282" class="v">200</text>
              <text x="316" y="300" class="n">content</text>
              <text x="378" y="300" class="b">{"{…}"}</text>
            </g>
            <g class="node node-decoded">
              <rect x="560" y="26" width="176" height="60" rx="10" />
              <text x="576" y="52" class="k">text (decoded)</text>
              <text x="576" y="72" class="s">"{"{"}"user":"…"{"}"}"</text>
            </g>
            <g class="node">
              <rect x="560" y="98" width="176" height="60" rx="10" />
              <text x="576" y="124" class="k">headers</text>
              <text x="576" y="144" class="b">[ 18 ]</text>
            </g>
            <g class="node">
              <rect x="560" y="222" width="176" height="60" rx="10" />
              <text x="576" y="248" class="k">body</text>
              <text x="576" y="268" class="s">image/png</text>
            </g>
          </svg>
        </figure>
      </div>
    </div>
  </section>

  <section class="formats" aria-label="Supported formats">
    <div class="container formats-inner">
      {formats.map((format) => <span class="format">{format}</span>)}
    </div>
  </section>

  <section id="features" class="section" aria-labelledby="features-title">
    <div class="container">
      <div class="section-head">
        <h2 id="features-title" class="display">Read, edit and annotate on one canvas</h2>
        <p>
          Quipu combines a data map with a drawing board, so reading a payload and annotating it
          happen in the same place.
        </p>
      </div>
      <div class="feature-grid">
        {
          features.map((feature) => (
            <article class="feature tile" id={feature.id}>
              <h3>{feature.name}</h3>
              <p>{feature.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="privacy" class="section section-alt" aria-labelledby="privacy-title">
    <div class="container">
      <div class="section-head">
        <h2 id="privacy-title" class="display">Your data stays yours</h2>
        <p>
          A 2&nbsp;GB capture you are not allowed to upload is exactly the file Quipu is built for.
        </p>
      </div>
      <div class="privacy-grid">
        {
          privacy.map((item) => (
            <article class="privacy-item">
              <h3>{item.name}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="name-title">
    <div class="container name-note">
      <h2 id="name-title" class="display">Why Quipu?</h2>
      <p>
        A quipu is the Inca record made of knotted cords. Strings hang from strings, and knots hold
        the values. It was a tree of strings carrying data, five hundred years before JSON. Nested
        stringified JSON is literally a quipu.
      </p>
    </div>
  </section>

  {
    (release !== null || webAppPath !== null) && (
      <section id="download" class="section section-cta" aria-labelledby="download-title">
        <div class="container cta-inner">
          <h2 id="download-title" class="display">Get Quipu</h2>
          <p>
            {release !== null && webAppPath !== null
              ? "The desktop app for Linux and Windows, or open it right here in the browser."
              : release !== null
                ? "The desktop app for Linux and Windows."
                : "Open it right here in the browser."}
          </p>
          <div class="hero-actions">
            {release !== null && (
              <a class="btn btn-primary btn-lg" href={DOWNLOAD_PAGE_PATH}>
                Download
              </a>
            )}
            {webAppPath !== null && (
              <a class:list={["btn btn-lg", release === null ? "btn-primary" : "btn-ghost"]} href={webAppPath}>
                Open in the browser
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .hero {
    padding: 9vh 0 3rem;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-title {
    margin-top: 18px;
    font-size: clamp(2.5rem, 6.4vw, 5rem);
  }

  .hero-line {
    display: block;
  }

  .hero-sub {
    margin-top: 24px;
    max-width: 44rem;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--muted-foreground);
  }

  .hero-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .hero-note {
    margin-top: 14px;
    font-size: 13px;
    color: var(--muted-foreground);
  }

  .hero-note a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero-map-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-map {
    margin-top: 56px;
    width: min(880px, 100%);
    padding: 20px;
  }

  .hero-map svg {
    width: 100%;
    height: auto;
  }

  .edges path {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .node rect {
    fill: var(--muted);
    stroke: var(--border-strong);
  }

  .node-decoded rect {
    stroke: var(--primary);
  }

  .node text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--muted-foreground);
  }

  .node .k {
    fill: var(--foreground);
    font-weight: 600;
  }

  .node .s {
    fill: var(--success);
  }

  .node .v,
  .node .b {
    fill: var(--primary);
  }

  .formats {
    border-block: 1px solid var(--border);
    padding: 18px 0;
  }

  .formats-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
  }

  .format {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
  }

  .section {
    padding: 96px 0;
  }

  .section-alt {
    background: var(--muted);
    border-block: 1px solid var(--border);
  }

  .section-head {
    max-width: 44rem;
    margin-bottom: 48px;
  }

  .section-head h2,
  .name-note h2,
  .cta-inner h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
  }

  .section-head p,
  .name-note p,
  .cta-inner p {
    margin-top: 14px;
    color: var(--muted-foreground);
    font-size: 1.05rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .feature {
    padding: 24px;
  }

  .feature h3,
  .privacy-item h3 {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .feature p,
  .privacy-item p {
    margin-top: 10px;
    color: var(--muted-foreground);
    font-size: 0.95rem;
  }

  .privacy-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  .name-note {
    max-width: 48rem;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  @media (max-width: 960px) {
    .feature-grid,
    .privacy-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 820px) {
    .container {
      padding-left: 20px;
      padding-right: 20px;
    }

    .section {
      padding: 64px 0;
    }
  }
</style>
